# Avi.Intelligence configuration.
# Copy to `.env` (repo root) and fill in values. `.env` is git-ignored: NEVER commit real secrets.

# --- General --------------------------------------------------------------------------------
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
APP_TIME_ZONE=Australia/Sydney

# Local demo uses SQLite. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./avi_intelligence.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development-only stand-in for sign-in (ignored when APP_ENV=production).
# admin | project_manager | cra | data_manager | safety | viewer
DEV_USER_ROLE=admin
# Which demo person you are (backend/src/app/auth/directory.py), e.g. demo-cra-1 to try "My Tasks"
DEV_USER_ID=dev-user

# --- SimpleTrials (CTMS) -------------------------------------------------------------------------
# Only "mock" (fictional demo studies) exists today; export import and API modes come next.
SIMPLETRIALS_MODE=mock

# --- SharePoint SOP library (Microsoft Graph, app-only) ------------------------------------------
# auto = live when the four values below are set, otherwise demo data. live | mock force a mode.
SHAREPOINT_MODE=auto
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# Full site URL, e.g. https://avionmedical.sharepoint.com/sites/QualityManagement
SHAREPOINT_SITE_URL=
# Document library name as shown in SharePoint, e.g. "Documents" or "Controlled Documents"
SHAREPOINT_SOP_LIBRARY=Documents
# Optional folder inside the library, e.g. "SOPs" or "Controlled Documents/SOPs"
SHAREPOINT_SOP_FOLDER=
# Optional subfolders of the SOP folder that are not SOPs (semicolon-separated)
SHAREPOINT_SOP_EXCLUDE_FOLDERS=
# File types counted as SOPs. Department falls back to the first subfolder name ("01. Clinical Operations").
SHAREPOINT_SOP_FILE_TYPES=docx,doc,pdf
# Optional JSON mapping of SOP fields to SharePoint column internal names.
# Fields: sop_number, title, version, status, effective_date, review_date, owner, department
# Example: {"sop_number": "DocNo", "status": "ApprovalState"}
SHAREPOINT_SOP_FIELD_MAP=
SHAREPOINT_CACHE_MINUTES=5

# --- AI assistant: "Ask Avi.Intelligence" (Anthropic Claude API) ------------------------------
# Without a key the assistant runs search-only (returns relevant SOP passages, no written answer).
# Create a key at https://console.anthropic.com. Questions and SOP excerpts are sent to Anthropic.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = more thorough, slower and more expensive)
ASSISTANT_EFFORT=medium

# Trust the Windows/OS certificate store for outbound HTTPS (needed behind TLS-inspecting proxies).
USE_SYSTEM_TRUST_STORE=true
