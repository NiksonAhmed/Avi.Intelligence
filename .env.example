# Avi.Intelligence configuration.
# Copy to `.env` (repo root) and fill in values. `.env` is git-ignored: NEVER commit real secrets.

# --- General --------------------------------------------------------------------------------
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
APP_TIME_ZONE=Australia/Sydney

# Local demo uses SQLite. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./avi_intelligence.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development-only stand-in for sign-in (ignored when APP_ENV=production).
# admin | project_manager | cra | data_manager | safety | qa | cta | viewer
DEV_USER_ROLE=admin
# Which demo person you are (backend/src/app/auth/directory.py), e.g. demo-cra-1 to try "My Tasks"
DEV_USER_ID=dev-user

# --- SimpleTrials (CTMS) API, read-only --------------------------------------------------------
# auto = API when credentials below are set, otherwise demo studies. api | mock force a mode.
# Credentials: SimpleTrials > Administration > Subscription & Settings > Customer Details > Manage API
# (Premium Plus; enable Read-only Access only). See docs/simpletrials-setup.md.
SIMPLETRIALS_MODE=auto
# Scheduled read-only sync for Reports and Insights, in minutes (0 = off). The first sync each day
# also stores a small snapshot of key figures for trend charts.
SIMPLETRIALS_SYNC_MINUTES=60
SIMPLETRIALS_BASE_URL=https://app.simpletrials.com/api/v1/
SIMPLETRIALS_STUDY_ID=
SIMPLETRIALS_STUDY_KEY=
SIMPLETRIALS_CUSTOMER_ID=
SIMPLETRIALS_CUSTOMER_KEY=
# Extra key milestones by name (SimpleTrials' coded milestones such as FPI/LPI are always key)
SIMPLETRIALS_KEY_MILESTONES=Protocol Finalized;First Ethics Approval;Database Hard Lock;Clinical Study Report Finalized

# --- SharePoint SOP library (Microsoft Graph, app-only) ------------------------------------------
# auto = live when the four values below are set, otherwise demo data. live | mock force a mode.
SHAREPOINT_MODE=auto
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# Full site URL, e.g. https://avionmedical.sharepoint.com/sites/QualityManagement
SHAREPOINT_SITE_URL=
# Document library name as shown in SharePoint, e.g. "Documents" or "Controlled Documents"
SHAREPOINT_SOP_LIBRARY=Documents
# Optional folder inside the library, e.g. "SOPs" or "Controlled Documents/SOPs"
SHAREPOINT_SOP_FOLDER=
# Optional subfolders of the SOP folder that are not SOPs (semicolon-separated)
SHAREPOINT_SOP_EXCLUDE_FOLDERS=
# File types counted as SOPs. Department falls back to the first subfolder name ("01. Clinical Operations").
SHAREPOINT_SOP_FILE_TYPES=docx,doc,pdf
# true = only approved (Effective) documents are listed, opened or downloaded; drafts, documents in
# review and superseded versions never appear. Status comes from folder names (Approved / Draft
# Unapproved / Superseded) and the status column; the cautious answer wins.
SHAREPOINT_SOP_APPROVED_ONLY=true
# true = only SOPs and forms recognised by their number (CO-SOP-001, CO-005-A, SM-TEM-001, SOP-0042);
# hides change controls, executed records and unnumbered files.
SHAREPOINT_SOP_NUMBERED_ONLY=true
# Optional JSON mapping of SOP fields to SharePoint column internal names.
# Fields: sop_number, title, version, status, effective_date, review_date, owner, department
# Example: {"sop_number": "DocNo", "status": "ApprovalState"}
SHAREPOINT_SOP_FIELD_MAP=
SHAREPOINT_CACHE_MINUTES=5

# --- AI assistant: "Ask Avi.Intelligence" (Anthropic Claude API) ------------------------------
# Without a key the assistant runs search-only (returns relevant SOP passages, no written answer).
# Create a key at https://console.anthropic.com. Questions and SOP excerpts are sent to Anthropic.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = more thorough, slower and more expensive)
ASSISTANT_EFFORT=medium

# Trust the Windows/OS certificate store for outbound HTTPS (needed behind TLS-inspecting proxies).
USE_SYSTEM_TRUST_STORE=true

# --- Viedoc (EDC) for Data Management: read-only, one API client per study (Step 0: discovery) ---
# Create an API client for the study in Viedoc, then add one block per study. NAME is your own label
# (e.g. SANDBOX). Check the connection with:  cd backend; uv run python -m app.check_viedoc
# VIEDOC_CONNECTIONS__SANDBOX__API_URL=https://<your-region-api>.viedoc.net/...
# VIEDOC_CONNECTIONS__SANDBOX__CLIENT_ID=
# VIEDOC_CONNECTIONS__SANDBOX__CLIENT_SECRET=
# VIEDOC_CONNECTIONS__SANDBOX__TOKEN_URL=        # optional: looked up automatically when blank
# VIEDOC_CONNECTIONS__SANDBOX__SCOPE=            # optional: only if Viedoc asks for one
# VIEDOC_CONNECTIONS__SANDBOX__ENVIRONMENT=sandbox
# auto = use the connections above; mock = always the demo study (used by tests).
VIEDOC_MODE=auto
# Live studies are never read unless this is true (only after data-protection and Quality sign-off).
VIEDOC_ALLOW_LIVE=false
# The Data Management tab stays hidden until the module is ready.
DATA_MANAGEMENT_ENABLED=false
